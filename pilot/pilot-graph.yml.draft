# DRAFT, not active. Move to .github/workflows/pilot-graph.yml after the owner approves publishing to GitHub Pages.
# Prerequisites (owner): repo secret PILOT_PASSWORD; Settings > Pages > Source = "GitHub Actions".
# Unverified: action versions and the whole run (never executed).
name: pilot-graph
on:
  push:
    branches: [main]
    paths: [pilot/synthetic-graph.json, tools/pilot_build.py, graph/graf-wiki.html, .github/workflows/pilot-graph.yml]
  workflow_dispatch:
permissions:
  contents: write
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: true
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: pip install cryptography
      - run: python tools/pilot_build.py
        env:
          PILOT_PASSWORD: ${{ secrets.PILOT_PASSWORD }}
      - name: Commit encrypted graph
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add graph/graph.enc.json
          git commit -m "pilot: update encrypted synthetic graph" || exit 0
          git push
      - name: Assemble site (page is an artifact fragment: add doctype, charset, viewport)
        run: |
          mkdir site
          { printf '<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'; cat graph/graf-wiki.html; } > site/index.html
          cp graph/graph.enc.json site/
      - uses: actions/upload-pages-artifact@v3
        with:
          path: site
  deploy:
    needs: build
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.d.outputs.page_url }}
    steps:
      - id: d
        uses: actions/deploy-pages@v4
